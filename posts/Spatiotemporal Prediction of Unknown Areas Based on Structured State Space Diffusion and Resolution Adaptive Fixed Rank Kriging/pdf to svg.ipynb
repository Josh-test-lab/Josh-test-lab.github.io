   "source": [
    "import fitz  # PyMuPDF\n",
    "\n",
    "doc = fitz.open(\"Stations of 2a-7.pdf\")\n",
    "\n",
    "for page_num, page in enumerate(doc):\n",
    "    svg = page.get_svg_image()\n",
    "\n",
    "    with open(f\"page_{page_num+1}.svg\", \"w\", encoding=\"utf-8\") as f:\n",
    "        f.write(svg)"
   ]
  }
